{
  "expo": {
    "name": "FitHub",
    "slug": "fithub",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111318"
    },
    "android": {
      "package": "com.fithub.app",
      "versionCode": 7,
      "permissions": [
        "INTERNET",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111318"
      }
    },
    "ios": {
      "bundleIdentifier": "com.fithub.app",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FitHub uses your photos only when you choose a profile picture or add a photo to a workout post.",
          "cameraPermission": "FitHub uses your camera only when you choose to take a profile picture or workout photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF3B30",
          "defaultChannel": "gym-reminders"
        }
      ]
    ]
  }
}
